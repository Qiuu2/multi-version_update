        <!--
            Android 14+ (targetSdk 34+) crashes any foreground service that does not
            declare foregroundServiceType. The htapplib.aar declares EncodeService and
            DecodeService for voice intercom but does not set the type. We override
            the merged manifest entries here without touching the aar binary.
            tools:node="merge" preserves the aar's existing attributes (exported,
            intent-filter) and only adds foregroundServiceType.
        -->
        <service
            android:name="com.example.htapplib.EncodeService"
            android:foregroundServiceType="microphone"
            tools:node="merge" />
        <service
            android:name="com.example.htapplib.DecodeService"
            android:foregroundServiceType="microphone"
            tools:node="merge" />

