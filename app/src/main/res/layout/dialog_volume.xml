<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="500dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="寻呼音量："
            android:textColor="@color/side_title_text"
            android:textSize="25dp" />

        <TextView
            android:id="@+id/call_vol_num"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="8"
            android:textColor="@color/side_title_text"
            android:textSize="25dp" />

        <SeekBar
            android:id="@+id/call_volume"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="对讲音量："
            android:textColor="@color/side_title_text"
            android:textSize="25dp" />

        <TextView
            android:id="@+id/speak_vol_num"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="8"
            android:textColor="@color/side_title_text"
            android:textSize="25dp" />

        <SeekBar
            android:id="@+id/speak_volume"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/volume_set"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="点播音量："
            android:textColor="@color/side_title_text"
            android:textSize="25dp" />

        <TextView
            android:id="@+id/play_vol_num"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="8"
            android:textColor="@color/side_title_text"
            android:textSize="25dp" />

        <SeekBar
            android:id="@+id/play_volume"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <include layout="@layout/two_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/text_small"
        android:layout_marginBottom="@dimen/text_small"/>

</LinearLayout>