<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    android:orientation="vertical">

    <include layout="@layout/title_bar"></include>
    <!--<Chronometer
        android:id="@+id/time_length"
        android:layout_width="180dp"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        android:background="@mipmap/menu_title_back"
        android:gravity="center"
        android:text="00:00:00"
        android:textColor="@color/colorWhite"
        android:textSize="@dimen/dp_36" />-->
    <LinearLayout
        android:id="@+id/call_center_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/center_image"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@mipmap/me_icon_qq" />

        <TextView
            android:id="@+id/center_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="三年级二班"
            android:textSize="20dp" />

        <include
            android:id="@+id/seek_bar_all"
            layout="@layout/view_voice_seekbar"
            android:visibility="gone"></include>

    </LinearLayout>

    <Button
        android:id="@+id/stop_call"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/call_center_info"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/style_corners_blue_btn"
        android:text="@string/stop_tolk"
        android:visibility="visible" />
</RelativeLayout>