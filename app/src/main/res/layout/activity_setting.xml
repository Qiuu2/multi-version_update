<?xml version="1.0" encoding="UTF-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite2"
    android:fastScrollEnabled="true"
    android:orientation="vertical"
    android:paddingLeft="5dp"
    android:paddingRight="5dp"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="18dp"
            android:paddingTop="18dp">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@mipmap/me_icon_qq"/>

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="v2.0.1"
                android:textColor="#999999"
                android:textSize="14sp"/>
        </LinearLayout>


        <!--<com.htgd.radiocontrol.aeroradiocontrol.widget.view.ButtonBox
            android:id="@+id/item_volume"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical" />-->

        <!-- 原协议版本选择器（V2.2/V2.3/V2.4）已隐藏：
             - 用户切换协议版本会导致登录失败，UI 不再暴露
             - SpinnerBox view 保留 (visibility=gone) 是为了让 SettingActivity.java 中
               item_version = findViewById(...) 等调用仍能找到该 view，不抛 NPE
             - 服务器协议版本由 LoginActivity 强制锁定为 V2.4（B6 改动） -->
        <com.htgd.radiocontrol.aeroradiocontrol.widget.view.SpinnerBox
            android:id="@+id/item_version"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:visibility="gone"
            android:gravity="center_vertical"  />

        <!-- 替代行：静态显示 app 版本号 + 构建日期。
             左右各 50dp padding 让"版本号"和值往中间缩，跟下方"接听时间"等行视觉更对齐。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="50dp"
            android:paddingRight="50dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="版本号"
                android:textColor="#000000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/app_version_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="TW_V1.0.0.0:May 12 2026"
                android:textColor="#666666"
                android:textSize="14sp" />
        </LinearLayout>


        <com.htgd.radiocontrol.aeroradiocontrol.widget.view.SpinnerBox
            android:id="@+id/item_receive"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical" />


       <!-- <com.htgd.radiocontrol.aeroradiocontrol.widget.view.SpinnerBox
            android:id="@+id/item_ring"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical" />-->


        <com.htgd.radiocontrol.aeroradiocontrol.widget.view.ButtonBox
            android:id="@+id/item_clear"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical" />


        <com.htgd.radiocontrol.aeroradiocontrol.widget.view.ButtonBox
            android:id="@+id/item_zone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical" /> <com.htgd.radiocontrol.aeroradiocontrol.widget.view.ButtonBox
            android:id="@+id/item_exit"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical" />



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginTop="60dp"
            android:gravity="center"
            android:text="中国航天广电 技术支持"
            android:textColor="#585d7a"
            android:textSize="18dp"/>
    </LinearLayout>

</ScrollView>