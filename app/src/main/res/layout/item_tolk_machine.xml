<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_all"
    android:layout_width="match_parent"
    android:layout_height="55dp"
    android:background="@color/LightGrey2"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/item_big_image"
        android:layout_width="30dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_marginLeft="10dp"
        android:background="@mipmap/machine_call_image"
        android:padding="5dp" />

    <Button
        android:id="@+id/right_bt_duijiang"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_gravity="center_vertical|right"
        android:layout_marginRight="10dp"
        android:background="@drawable/sign_bt_style"
        android:text="@string/speech"
        android:textColor="@color/colorWhite"
        android:textSize="16dp" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_toLeftOf="@id/right_bt_duijiang"
        android:layout_toRightOf="@id/item_big_image"
        android:orientation="horizontal"
        android:weightSum="2.0">

        <TextView
            android:id="@+id/item_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:text="八年级二班"
            android:textSize="16dp" />
    </LinearLayout>


</RelativeLayout>