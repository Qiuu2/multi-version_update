<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/recording"
        android:layout_width="wrap_content"
        android:layout_height="300dp"
        android:gravity="bottom|center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:background="#4b4b4b"
            android:orientation="vertical"><!---->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imageView1"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginRight="@dimen/distance"
                    android:layout_marginTop="@dimen/text_small"
                    android:src="@mipmap/voice_rcd_hint" />

                <ImageView
                    android:id="@+id/volume"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="10dip"
                    android:layout_marginTop="10dip"
                    android:src="@mipmap/amp1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_weight="4"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/recoording_tip"
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:src="@mipmap/tip_recording"
                    android:layout_marginLeft="@dimen/text_small"
                    android:layout_marginRight="@dimen/text_small"
                    />
                <TextView
                    android:id="@+id/recorded_tip"
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:text="@string/loosen"
                    android:textSize="@dimen/text_small"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_marginLeft="@dimen/text_small"
                    android:layout_marginRight="@dimen/text_small"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="取消发送"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/img1"
            android:layout_width="30.0dip"
            android:layout_height="30.0dip"
            android:layout_marginLeft="10.0dip"
            android:layout_marginRight="20.0dip"
            android:background="@mipmap/voice_rcd_cancel_bg"
            android:padding="7.0dip"
            android:src="@mipmap/rcd_cancel_icon" />

        <LinearLayout
            android:id="@+id/del_re"
            android:layout_width="140.0dip"
            android:layout_height="140.0dip"
            android:layout_marginLeft="10.0dip"
            android:background="@mipmap/voice_rcd_cancel_bg_focused"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="取消"
                android:textColor="#ffffff"
                android:textSize="13.0dip" />

            <ImageView
                android:id="@+id/sc_img1"
                android:layout_width="75.0dip"
                android:layout_height="75.0dip"
                android:layout_marginTop="12.0dip"
                android:src="@mipmap/rcd_cancel_icon" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/record_loading"
        android:layout_width="140.0dip"
        android:layout_height="140.0dip"
        android:background="@drawable/voice_rcd_hint_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar1"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/record_tooshort"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/voice_rcd_hint_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@mipmap/voice_to_short" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15.0dip"
            android:text="时间太短未录制"
            android:textColor="#ff0000"
            android:textSize="18dp" />
    </LinearLayout>

</LinearLayout>