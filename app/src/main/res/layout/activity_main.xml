<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite2"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/title_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/title_bar" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/big_item_height">

        <com.htgd.radiocontrol.aeroradiocontrol.widget.CustomScrollViewPager
            android:id="@+id/my_viewpager"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="@color/white" />
    </RelativeLayout>

    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/rd_group"
        android:background="@color/LightGrey" />
    <RadioGroup
        android:id="@+id/rd_group"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:weightSum="5">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1.0">

            <RadioButton
                android:id="@+id/rd_menu_xunhu"
                android:layout_width="160dp"
                android:layout_height="100dp"
                android:layout_centerInParent="true"
                android:button="@null"
                android:scaleType="centerInside" />

             
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1.0">

            <RadioButton
                android:id="@+id/rd_menu_duijiang"
                android:layout_width="160dp"
                android:layout_height="100dp"
                android:layout_centerInParent="true"
                android:button="@null"
                android:scaleType="centerInside" />

             
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1.0">

            <RadioButton
                android:id="@+id/rd_menu_dianbo"
                android:layout_width="160dp"
                android:layout_height="100dp"
                android:layout_centerInParent="true"
                android:button="@null"
                android:scaleType="centerInside" />

            
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1.0">

            <RadioButton
                android:id="@+id/rd_menu_renwu"
                android:layout_width="160dp"
                android:layout_height="100dp"
                android:layout_centerInParent="true"
                android:button="@null"
                android:scaleType="centerInside" />

              
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1.0">

            <RadioButton
                android:id="@+id/rd_menu_kuaijie"
                android:layout_width="160dp"
                android:layout_height="100dp"
                android:layout_centerInParent="true"
                android:button="@null"
                android:scaleType="centerInside" />
 
        </RelativeLayout>
    </RadioGroup>
</RelativeLayout>